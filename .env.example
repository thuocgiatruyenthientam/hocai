# Example environment file for hocai
# Copy to .env and fill in real values (do NOT commit .env with real secrets)

SECRET_KEY=replace_with_random_secret
ADMIN_PASSWORD=REPLACE_ME_CHANGE_PASSWORD
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST/DBNAME?charset=utf8mb4
SERVER_NAME=hocai.site
PREFERRED_URL_SCHEME=https
